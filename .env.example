# Database Configuration
DB_URL=jdbc:h2:./data/monikamart;DB_CLOSE_DELAY=-1;MODE=MySQL;DATABASE_TO_UPPER=false
DB_USER=sa
DB_PASSWORD=

# Server Configuration
PORT=8080
SESSION_TIMEOUT_MINUTES=30

# Admin Security Configuration (Required for Admin login: monikaraja433@gmail.com)
